{
  "name": "pulseops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"wrangler dev --local --port 8787\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --local --port 8787",
    "db:migrate": "wrangler d1 migrations apply pulseops-db --local",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build && wrangler deploy --dry-run --outdir dist-worker",
    "db:migrate:remote": "wrangler d1 migrations apply pulseops-db --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
